.DS_Store
*/.DS_Store
node_modules
_site
.jekyll-cache
vendor/bundle

# Vite build outputs (generated by CI, no longer committed)
assets/js/*.min.js
assets/css/*.min.css
demo/*/js/*.min.js
demo/*/css/*.min.css
# demo/*/css/index.scss 全文被注释时，Rollup 仍会产出一个空 JS chunk 落到 css 目录
demo/*/css/*.min.js
# 旧 @vitejs/plugin-legacy 的输出目录（插件已移除，全站零引用）
vite-dist/
# Rollup 从 CSS url() 中提取到仓库根的 hash 命名资源（当前为 shakeDemo 的 shake_bg.<hash>.png）；
# 文件名随内容变动，入库会不断堆积旧版本，由 pnpm build 重新生成
/*.*.png

# Keep third-party library files
!demo/likeWxFloatDragBtnDemo/js/vue.min.js
!demo/openMapDemo/js/vue.min.js
!demo/echartsDemo/lib/echarts.min.js
!demo/echartsDemo/lib/vconsole.min.js

# 自动化写作流水线的中间产物
# evidence/ 里是每篇的一手证据清单：抓取命令、UTC 时间戳、原始响应片段。
# 这是最直接的机器生产痕迹，内容绝不入库；只保留目录本身（.gitkeep 反向放行）。
_drafts/evidence/*
!_drafts/evidence/.gitkeep
# deep-research skill 默认往仓库根目录写报告，流水线已改道 _drafts/evidence/，此处兜底
DEEP_RESEARCH_*.md
# baoyu-post-to-wechat 处理纯文本输入时的暂存目录
post-to-wechat/
# baoyu skill 凭据（DASHSCOPE_API_KEY 等）
.baoyu-skills/.env
# 运行时原生出图工具的落盘目录：每张 ~2MB PNG，都是中间产物，
# 会被搬进 assets/img/{slug}/ 并转成 webp，原件不入库
vibe_images/
