{
  "name": "liaolongdong.github.io",
  "version": "2.1.0",
  "description": "廖小新的个人博客",
  "scripts": {
    "dev": "concurrently -n assets,jekyll -c blue,magenta \"vite build --watch\" \"bundle exec jekyll serve\"",
    "dev:assets": "vite build --watch",
    "dev:server": "bundle exec jekyll serve",
    "build": "vite build && vite build --config vite.demo.config.js",
    "build:assets": "vite build",
    "build:demo": "vite build --config vite.demo.config.js",
    "build:site": "pnpm build && bundle exec jekyll build",
    "og:images": "node scripts/og-images.mjs",
    "og:check": "node scripts/og-images.mjs --check",
    "wechat:draft": "node scripts/wechat-draft.mjs",
    "wechat:draft:latest": "node scripts/wechat-draft.mjs --latest --dry-run",
    "deploy": "bash deploy-github.sh",
    "deploy:ali": "bash deploy-ali.sh"
  },
  "author": "Better",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "postcss": "^8.4.49",
    "postcss-px-to-viewport": "^1.1.1",
    "sass": "^1.82.0",
    "terser": "^5.37.0",
    "vite": "^6.0.0"
  }
}
